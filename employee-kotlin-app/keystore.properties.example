# Copy to keystore.properties (gitignored) and fill in to sign release builds.
# Create the keystore first:
#
#   keytool -genkeypair -v -keystore mcc-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias mcc
#
# Keep the .jks file and these passwords out of version control and back them
# up: losing the key means you can never ship an update to an installed app,
# because Android refuses an APK signed by a different key.
storeFile=mcc-release.jks
storePassword=CHANGE_ME
keyAlias=mcc
keyPassword=CHANGE_ME
