 parent="1"><mxGeometry x="505" y="145" width="170" height="50" as="geometry"/></mxCell><mxCell id="p2-in" value="Open a portal login page;&lt;br&gt;enter email and password" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="258" width="240" height="64" as="geometry"/></mxCell><mxCell id="p2-cap" value="reCAPTCHA&lt;br&gt;passed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="386" width="190" height="96" as="geometry"/></mxCell><mxCell id="p2-dom" value="Valid email domain?&lt;br&gt;(admin portal:&lt;br&gt;@mcc.edu.ph only)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="485" y="520" width="210" height="104" as="geometry"/></mxCell><mxCell id="p2-usr" value="Account&lt;br&gt;exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="662" width="190" height="96" as="geometry"/></mxCell><mxCell id="p2-pw" value="Password&lt;br&gt;correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="794" width="190" height="96" as="geometry"/></mxCell><mxCell id="p2-rol" value="Role matches&lt;br&gt;the portal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="926" width="190" height="96" as="geometry"/></mxCell><mxCell id="p2-isck" value="Attendance&lt;br&gt;Checker?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="1058" width="190" height="96" as="geometry"/></mxCell><mxCell id="p2-isem" value="Employee&lt;br&gt;account?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="1190" width="190" height="96" as="geometry"/></mxCell><mxCell id="p2-act" value="Active (or first&lt;br&gt;sign-in) and linked to&lt;br&gt;employee roster?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1321" width="220" height="110" as="geometry"/></mxCell><mxCell id="p2-err" value='Show error message and&lt;br&gt;return to the login form&lt;br&gt;&lt;br&gt;e.g. "User not yet registered",&lt;br&gt;"Password is wrong",&lt;br&gt;"Access denied — use the&lt;br&gt;correct portal",&lt;br&gt;"Account is not active"' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="384" width="230" height="1042" as="geometry"/></mxCell><mxCell id="p2-cks" value="Start attendance&lt;br&gt;checker session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="1074" width="180" height="64" as="geometry"/></mxCell><mxCell id="p2-ckd" value="Attendance Checker&lt;br&gt;Dashboard (see 8)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="105" y="1218" width="190" height="64" as="geometry"/></mxCell><mxCell id="p2-gen" value="Generate 6-digit OTP&lt;br&gt;(valid for 5 minutes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="485" y="1494" width="210" height="64" as="geometry"/></mxCell><mxCell id="p2-mail" value="Email the OTP&lt;br&gt;to the user" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="1623" width="200" height="70" as="geometry"/></mxCell><mxCell id="p2-otp" value="Enter the OTP code" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1758" width="220" height="64" as="geometry"/></mxCell><mxCell id="p2-ok" value="OTP correct and&lt;br&gt;not expired?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="1878" width="200" height="100" as="geometry"/></mxCell><mxCell id="p2-five" value="5 wrong&lt;br&gt;attempts?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="1880" width="190" height="96" as="geometry"/></mxCell><mxCell id="p2-lock" value="Lock verification&lt;br&gt;for 15 minutes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="2046" width="190" height="64" as="geometry"/></mxCell><mxCell id="p2-msg" value="Show error&lt;br&gt;(attempts left or&lt;br&gt;lock time)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="1755" width="190" height="70" as="geometry"/></mxCell><mxCell id="p2-save" value="Save last login and IP;&lt;br&gt;activate a pending&lt;br&gt;employee account" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="2055" width="220" height="70" as="geometry"/></mxCell><mxCell id="p2-li" value="Log the user in" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="2195" width="190" height="54" as="geometry"/></mxCell><mxCell id="p2-home" value="Role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;