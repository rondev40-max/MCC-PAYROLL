55;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;fontColor=#0f172a;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-d5" target="p7-d6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="8. Attendance Checker (Department DTR)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1395" pageHeight="2175" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8-title" value="&lt;b style=&quot;font-size:22px&quot;&gt;8. Attendance Checker (Department DTR)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;Each attendance checker is assigned to one department and can only see and encode that department's employees.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1315" height="80" as="geometry"/></mxCell><mxCell id="p8-start" value="Checker opens the&lt;br&gt;Attendance Portal" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="551" y="142" width="190" height="56" as="geometry"/></mxCell><mxCell id="p8-fg" value="Forgot&lt;br&gt;password?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="551" y="266" width="190" height="96" as="geometry"/></mxCell><mxCell id="p8-f1" value="Enter the account email" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="125" y="426" width="210" height="64" as="geometry"/></mxCell><mxCell id="p8-f2" value="Email a reset&lt;br&gt;OTP code" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="555" width="180" height="70" as="geometry"/></mxCell><mxCell id="p8-f3" value="Enter the OTP code" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="690" width="200" height="64" as="geometry"/></mxCell><mxCell id="p8-f4" value="Code valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="817" width="160" height="86" as="geometry"/></mxCell><mxCell id="p8-f5" value="Set a new password" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="966" width="200" height="64" as="geometry"/></mxCell><mxCell id="p8-login" value="Sign in with email and password&lt;br&gt;(see 2. Login &amp;amp; Authentication)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="511" y="426" width="270" height="64" as="geometry"/></mxCell><mxCell id="p8-dash" value="Dashboard: employees of the checker's&lt;br&gt;assigned department only&lt;br&gt;(BSIT, BSBA, BSHM or Education)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="496" y="570" width="300" height="76" as="geometry"/></mxCell><mxCell id="p8-cut" value="Select the cut-off period&lt;br&gt;(1–15 or 16–end)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="521" y="720" width="250" height="64" as="geometry"/></mxCell><mxCell id="p8-load" value="Load the department roster&lt;br&gt;and saved attendance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="526" y="852" width="240" height="64" as="geometry"/></mxCell><mxCell id="p8-enc" value="Encode A.M./P.M. arrival and departure,&lt;br&gt;status (present, absent, late, half-day,&lt;br&gt;leave, holiday) and remarks" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="486" y="988" width="320" height="80" as="geometry"/></mxCell><mxCell id="p8-val" value="Entries valid and&lt;br&gt;own department?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="546" y="1140" width="200" height="100" as="geometry"/></mxCell><mxCell id="p8-err" value="Show the error&lt;br&gt;message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1016" y="1162" width="170" height="56" as="geometry"/></mxCell><mxCell id="p8-save" value="Save attendance and&lt;br&gt;attendance history" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="536" y="1314" width="220" height="64" as="geometry"/></mxCell><mxCell id="p8-db" value="Attendance&lt;br&gt;records" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f1f5f9;strokeColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1016" y="1308" width="170" height="76" as="geometry"/></mxCell><mxCell id="p8-dtr" value="Open the Daily&lt;br&gt;Time Record?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" ve