l></root></mxGraphModel></diagram><diagram id="p6" name="6. Payroll Processing (Send Payslips)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1378" pageHeight="2709" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6-title" value='&lt;b style="font-size:22px"&gt;6. Payroll Processing (Send Payslips)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#475569"&gt;Run by the admin from the "Send Payslips (All)" button in the sidebar. Every payslip is stored in the payroll history, whether or not its email was delivered.&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1298" height="80" as="geometry"/></mxCell><mxCell id="p6-start" value='Admin clicks&lt;br&gt;"Send Payslips (All)"' style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="142" width="200" height="56" as="geometry"/></mxCell><mxCell id="p6-in" value="Select the pay period:&lt;br&gt;start date and end date" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="264" width="240" height="64" as="geometry"/></mxCell><mxCell id="p6-dt" value="End date on or&lt;br&gt;after start date?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="390" width="200" height="100" as="geometry"/></mxCell><mxCell id="p6-cf" value="Confirm&lt;br&gt;sending?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="542" width="190" height="96" as="geometry"/></mxCell><mxCell id="p6-cancel" value="END&lt;br&gt;(cancelled)" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="138" y="562" width="150" height="56" as="geometry"/></mxCell><mxCell id="p6-cut" value="Determine the cut-off from the&lt;br&gt;start date (1–15 or 16–end)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="465" y="696" width="250" height="64" as="geometry"/></mxCell><mxCell id="p6-col" value="Collect the timesheets of that cut-off:&lt;br&gt;Full-time, Part-time, Staff, Utility,&lt;br&gt;Watchman, Admin Personnel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="445" y="828" width="290" height="76" as="geometry"/></mxCell><mxCell id="p6-tdb" value="Timesheet&lt;br&gt;tables" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f1f5f9;strokeColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="128" y="828" width="170" height="76" as="geometry"/></mxCell><mxCell id="p6-any" value="Any employees&lt;br&gt;found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="962" width="190" height="96" as="geometry"/></mxCell><mxCell id="p6-att" value="Apply Attendance Payroll for enabled&lt;br&gt;employees: paid hours / days come&lt;br&gt;from Time In / Time Out (see 7)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="445" y="1116" width="290" height="76" as="geometry"/></mxCell><mxCell id="p6-iss" value="Attendance problems?&lt;br&gt;(open or flagged sessions,&lt;br&gt;incomplete cut-off, no rate)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1252" width="240" height="116" as="geometry"/></mxCell><mxCell id="p6-err" value="Stop and show the&lt;br&gt;error message&lt;br&gt;&lt;br&gt;• invalid dates&lt;br&gt;• no employees in the range&lt;br&gt;• attendance issues to&lt;br&gt;  resolve first" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="974" y="390" width="220" height="970" as="geometry"/></mxCell><mxCell id="p6-next" value="Take the next employee" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="485" y="1445" width="210" height="54" as="geometry"/></mxCell><mxCell id="p6-cmp" value="Gross = days or hours × rate&lt;br&gt;Deductions = Tax + GSIS + PhilHealth&lt;br&gt;+ Pag-IBIG + SSS + other&lt;br&gt;Net pay = Gross − Deductions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="445" y="1567" width="290" height="86" as="geometry"/></mxCell><mxCell id="p6-em" value="Employee has an&lt;br&gt;email address?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="1722" width="200" height="100" as="geometry"/></mxCell><mxCell id="p6-rec" value="Record the payslip in&lt;br&gt;history only (no email)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="979" y="1740" width="210" height="64" as="geometry"/></mxCell><mxCell id="p6-send" value="Email the payslip&lt;br&gt;to the employee" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="1881" width="200" height="70" as="geometry"/></mxCell><mxCell id="p6-ok" value="Email sent&lt;br&gt;successfully?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="2012" width="190" height="96" as="geometry"/></mxCell><mxCell id="p6-fail" value="Save payslip history&lt;br&gt;with the error message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="979" y="2028" width="210" height="64" as="geometry"/></mxCell><mxCell id="p6-save" value="Save payslip history&lt;br&gt;(gross, deductions, net)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="475" y="2172" width="230" height="64" as="geometry"/></mxCell><mxCell id="p6-pdb" value="Payslip&lt;br&gt;history" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f1f5f9;strokeColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="128" y="2166" width="170" height="76" as="geometry"/></mxCell><mxCell id="p6-more" value="More&lt;br&gt;employees?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="2300" width="190" height="96" as="geometry"/></mxCell><mxCell id="p6-sum" value="Show summary: payslips sent,&lt;br&gt;failed, and recorded without email" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="445" y="2466" width="290" height="64" as="geometry"/></mxCell><mxCell id="p6-end" value="END" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="2599" width="170" height="50" as="geometry"/></mxCell><mxCell id="p6-edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLo