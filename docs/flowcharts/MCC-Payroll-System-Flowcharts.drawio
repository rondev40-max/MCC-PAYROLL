<mxfile host="app.diagrams.net" agent="MCC Payroll flowchart generator" version="24.7.17" type="device"><diagram id="p1" name="1. Overall System Flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1885" pageHeight="1755" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-title" value='&lt;b style="font-size:22px"&gt;1. Overall System Flow&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#475569"&gt;How each type of user moves through MCC Digital Payroll. Green boxes with double sides are predefined processes drawn in detail on the page named in them.&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1805" height="80" as="geometry"/></mxCell><mxCell id="p1-box0" value="Legend" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1331" y="128" width="494" height="828" as="geometry"/></mxCell><mxCell id="p1-start" value="START" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="145" width="170" height="50" as="geometry"/></mxCell><mxCell id="p1-site" value="Open the MCC Digital Payroll website&lt;br&gt;(landing page: announcements and&lt;br&gt;system status)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="255" width="280" height="70" as="geometry"/></mxCell><mxCell id="p1-portal" value="Which portal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="495" y="392" width="190" height="96" as="geometry"/></mxCell><mxCell id="p1-adm" value="Admin Portal&lt;br&gt;(management login)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="564" width="220" height="64" as="geometry"/></mxCell><mxCell id="p1-emp" value="Employee Portal&lt;br&gt;(sign in, or register — see 3)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="345" y="564" width="230" height="64" as="geometry"/></mxCell><mxCell id="p1-chk" value="Attendance Checker&lt;br&gt;Portal" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="564" width="220" height="64" as="geometry"/></mxCell><mxCell id="p1-mob" value="Mobile App" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1041" y="564" width="190" height="64" as="geometry"/></mxCell><mxCell id="p1-auth" value="Sign in and verify the account&lt;br&gt;(see 2. Login &amp;amp; Authentication)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="335" y="726" width="250" height="64" as="geometry"/></mxCell><mxCell id="p1-mapi" value="Token sign-in and&lt;br&gt;read-only data&lt;br&gt;(see 10. Mobile App)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1036" y="723" width="200" height="70" as="geometry"/></mxCell><mxCell id="p1-mend" value="END" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1051" y="877" width="170" height="50" as="geometry"/></mxCell><mxCell id="p1-role" value="User role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="365" y="866" width="190" height="96" as="geometry"/></mxCell><mxCell id="p1-sa" value="User Management&lt;br&gt;(Super Admin creates accounts;&lt;br&gt;also has all Admin functions)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="85" y="1050" width="230" height="76" as="geometry"/></mxCell><mxCell id="p1-ad" value="Admin Dashboard&lt;br&gt;(see 4. Admin Portal)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="1056" width="200" height="64" as="geometry"/></mxCell><mxCell id="p1-ep" value="Employee Portal&lt;br&gt;(see 9. Employee Portal)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="1056" width="200" height="64" as="geometry"/></mxCell><mxCell id="p1-ck" value="Checker Dashboard&lt;br&gt;(see 8. Attendance Checker)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="1056" width="220" height="64" as="geometry"/></mxCell><mxCell id="p1-ts" value="Manage employees and&lt;br&gt;timesheets (see 5)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="1212" width="200" height="64" as="geometry"/></mxCell><mxCell id="p1-att" value="Time In / Time Out&lt;br&gt;(see 7. Attendance)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="1212" width="200" height="64" as="geometry"/></mxCell><mxCell id="p1-dtr" value="Encode department&lt;br&gt;attendance and DTR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="1212" width="200" height="64" as="geometry"/></mxCell><mxCell id="p1-pay" value="Process payroll and email&lt;br&gt;payslips (see 6)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="355" y="1362" width="210" height="64" as="geometry"/></mxCell><mxCell id="p1-slip" value="View payslips, announcements,&lt;br&gt;evaluation (see 9)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="1362" width="220" height="64" as="geometry"/></mxCell><mxCell id="p1-out" value="Log out" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="1525" width="170" height="50" as="geometry"/></mxCell><mxCell id="p1-end" value="END" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="1645" width="170" height="50" as="geometry"/></mxCell><mxCell id="p1-lg0" value="START / END" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1388" y="166" width="120" height="44" as="geometry"/></mxCell><mxCell id="p1-lt0" value="Terminator: where a flow starts or ends" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1556" y="166" width="200" height="44" as="geometry"/></mxCell><mxCell id="p1-lg1" value="Process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1388" y="260" width="120" height="44" as="geometry"/></mxCell><mxCell id="p1-lt1" value="Process: an action the system or user does" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1556" y="260" width="200" height="44" as="geometry"/></mxCell><mxCell id="p1-lg2" value="Yes / No?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1388" y="353" width="120" height="44" as="geometry"/></mxCell><mxCell id="p1-lt2" value="Decision: the flow branches on the answer" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1556" y="353" width="200" height="44" as="geometry"/></mxCell><mxCell id="p1-lg3" value="Input / Output" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1388" y="447" width="120" height="44" as="geometry"/></mxCell><mxCell id="p1-lt3" value="Input / output: data entered or shown" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1556" y="447" width="200" height="44" as="geometry"/></mxCell><mxCell id="p1-lg4" value="Other page" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1388" y="540" width="120" height="44" as="geometry"/></mxCell><mxCell id="p1-lt4" value="Predefined process: detailed on another page" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1556" y="540" width="200" height="44" as="geometry"/></mxCell><mxCell id="p1-lg5" value="Email / Print" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1388" y="634" width="120" height="44" as="geometry"/></mxCell><mxCell id="p1-lt5" value="Document: an email sent or a printout" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1556" y="634" width="200" height="44" as="geometry"/></mxCell><mxCell id="p1-lg6" value="Data" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f1f5f9;strokeColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1388" y="722" width="120" height="56" as="geometry"/></mxCell><mxCell id="p1-lt6" value="Data store: records saved in the database" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1556" y="728" width="200" height="44" as="geometry"/></mxCell><mxCell id="p1-lg7" value="Error" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1388" y="821" width="120" height="44" as="geometry"/></mxCell><mxCell id="p1-lt7" value="Error message shown to the user" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1556" y="821" width="200" height="44" as="geometry"/></mxCell><mxCell id="p1-comp" value="System components&lt;br&gt;&lt;br&gt;• Web application: Laravel (PHP)&lt;br&gt;• Database: MySQL&lt;br&gt;• Email (SMTP): sign-in codes, payslip codes, payslips&lt;br&gt;• Security: reCAPTCHA, email one-time codes (OTP), role-based access&lt;br&gt;• Mobile API: Laravel Sanctum tokens&lt;br&gt;• Scheduler: closes forgotten attendance daily at 11:59 PM" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8fafc;strokeColor=#94a3b8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1343" y="1037" width="470" height="150" as="geometry"/></mxCell><mxCell id="p1-idx" value="Pages in this file&lt;br&gt;&lt;br&gt;1. Overall System Flow&lt;br&gt;2. Login &amp;amp; Authentication&lt;br&gt;3. Employee Registration&lt;br&gt;4. Admin Portal&lt;br&gt;5. Timesheet Management&lt;br&gt;6. Payroll Processing (Send Payslips)&lt;br&gt;7. Employee Attendance&lt;br&gt;8. Attendance Checker&lt;br&gt;9. Employee Portal &amp;amp; Payslip Access&lt;br&gt;10. Mobile App" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8fafc;strokeColor=#94a3b8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1343" y="1286" width="470" height="205" as="geometry"/></mxCell><mxCell id="p1-edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;fontColor=#0f172a;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-start" target="p1-site"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;fontColor=#0f172a;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-site" target="p1-portal"><mxGeometry relative="1" as="ge