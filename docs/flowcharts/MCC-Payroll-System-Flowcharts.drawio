).&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1664" height="80" as="geometry"/></mxCell><mxCell id="p5-start" value="Admin opens the&lt;br&gt;Employees menu" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="142" width="180" height="56" as="geometry"/></mxCell><mxCell id="p5-cat" value="Select employee&lt;br&gt;category" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="270" width="200" height="100" as="geometry"/></mxCell><mxCell id="p5-c0" value="Full-Time&lt;br&gt;Instructors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175" y="454" width="170" height="56" as="geometry"/></mxCell><mxCell id="p5-c1" value="Part-Time&lt;br&gt;Instructors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="454" width="170" height="56" as="geometry"/></mxCell><mxCell id="p5-c2" value="Staff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="695" y="454" width="170" height="56" as="geometry"/></mxCell><mxCell id="p5-c3" value="Utility&lt;br&gt;Workers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="955" y="454" width="170" height="56" as="geometry"/></mxCell><mxCell id="p5-c4" value="Watchman" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1215" y="454" width="170" height="56" as="geometry"/></mxCell><mxCell id="p5-c5" value="Admin&lt;br&gt;Personnel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1475" y="454" width="170" height="56" as="geometry"/></mxCell><mxCell id="p5-open" value="Open the category's&lt;br&gt;timesheet page" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="795" y="594" width="230" height="64" as="geometry"/></mxCell><mxCell id="p5-filt" value="Choose Month, Period (1–15 or 16–end),&lt;br&gt;Year, and Department (instructors)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="731" width="320" height="66" as="geometry"/></mxCell><mxCell id="p5-load" value="Load the timesheets; build the days&lt;br&gt;of the cut-off; mark Sundays and holidays" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="869" width="320" height="66" as="geometry"/></mxCell><mxCell id="p5-db" value="Timesheet&lt;br&gt;tables" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f1f5f9;strokeColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1345" y="864" width="170" height="76" as="geometry"/></mxCell><mxCell id="p5-show" value="Display the timesheet table&lt;br&gt;(hours, rate, deductions, totals)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="1007" width="290" height="66" as="geometry"/></mxCell><mxCell id="p5-act" value="Choose an action" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1146" width="200" height="100" as="geometry"/></mxCell><mxCell id="p5-a1" value="Add: fill the Add Entry form&lt;br&gt;(name, email, department,&lt;br&gt;hours per day, rate)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="145" y="1332" width="230" height="76" as="geometry"/></mxCell><mxCell id="p5-a1b" value="Compute total hours / days&lt;br&gt;and honorarium (skip&lt;br&gt;Sundays and holidays)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="155" y="1482" width="210" height="76" as="geometry"/></mxCell><mxCell id="p5-a1c" value="Save the new entry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="165" y="1631" width="190" height="54" as="geometry"/></mxCell><mxCell id="p5-a2" value="Edit: change a cell in the&lt;br&gt;table (hours, rate,&lt;br&gt;deductions)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="423" y="1334" width="220" height="72" as="geometry"/></mxCell><mxCell id="p5-a2b" value="Auto-save and recompute&lt;br&gt;totals and honorarium" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="428" y="1487" width="210" height="66" as="geometry"/></mxCell><mxCell id="p5-a3" value="Delete:&lt;br&gt;confirm?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="731" y="1325" width="150" height="90" as="geometry"/></mxCell><mxCell id="p5-a3b" value="Delete the entry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="721" y="1493" width="170" height="54" as=