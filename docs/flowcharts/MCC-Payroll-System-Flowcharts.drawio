"shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.07;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="582" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9-t1" value="View the payslip list&lt;br&gt;(period, date sent)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="582" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9-t2" value="Read announcements;&lt;br&gt;mark one or all as read" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="582" width="200" height="64" as="geometry"/></mxCell><mxCell id="p9-t3" value="View and update&lt;br&gt;profile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="582" width="180" height="64" as="geometry"/></mxCell><mxCell id="p9-t4" value="Log out (END)" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="589" width="160" height="50" as="geometry"/></mxCell><mxCell id="p9-t5" value="Evaluation already&lt;br&gt;submitted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1405" y="566" width="190" height="96" as="geometry"/></mxCell><mxCell id="p9-u" value="Payslips unlocked&lt;br&gt;on this device?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="365" y="722" width="190" height="96" as="geometry"/></mxCell><mxCell id="p9-s" value="Email a 6-digit code to the&lt;br&gt;account email (resend&lt;br&gt;after 60 seconds)" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="886" width="220" height="80" as="geometry"/></mxCell><mxCell id="p9-i" value="Enter the code" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=16;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1"><mxGeometry x="365" y="1038" width="190" height="64" as="geometry"/></mxCell><mxCell id="p9-ok" value="Code correct?&lt;br&gt;(valid 5 minutes,&lt;br&gt;max 5 tries)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="365" y="1168" width="190" height="104" as="geometry"/></mxCell><mxCell id="p9-bad" value="Show error;&lt;br&gt;try again or resend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="115" y="1190" width="170" height="60" as="geometry"/></mxCell><mxCell id="p9-un" value="Unlock payslips&lt;br&gt;for 10 minutes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="365" y="1342" width="190" height="56" as="geometry"/></mxCell><mxCell id="p9-view" value="View or download the payslip PDF&lt;br&gt;and wage breakdown&lt;br&gt;(gross, deductions, net pay)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="335" y="1470" width="250" height="76" as="geometry"/></mxCell><mxCell id="p9-pend" value="END (payslips lock again&lt;br&gt;manually or after 10 min)" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="345" y="1624" width="230" height="56" as="geometry"/></mxCell><mxCell id="p9-pdb" value="Payslip&lt;br&gt;history" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundO