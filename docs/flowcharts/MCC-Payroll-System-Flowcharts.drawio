e Attendance (Time In / Time Out)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#475569"&gt;Employees record duty hours in the Employee Portal. Sessions are stored as Attendance Sessions; unusual ones are flagged for the admin, and completed hours feed payroll (page 6).&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="2077" height="80" as="geometry"/></mxCell><mxCell id="p7-box0" value="A. Time In" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="69" y="144" width="1066" height="882" as="geometry"/></mxCell><mxCell id="p7-box1" value="B. Time Out" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1226" y="144" width="871" height="882" as="geometry"/></mxCell><mxCell id="p7-box2" value="C. Automatic close (daily scheduler)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="69" y="1086" width="1066" height="780" as="geometry"/></mxCell><mxCell id="p7-box3" value="D. Admin review (Attendance Payroll page)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1226" y="1086" width="871" height="948" as="geometry"/></mxCell><mxCell id="p7-a0" value="Employee clicks&lt;br&gt;Time In" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="335" y="182" width="170" height="56" as="geometry"/></mxCell><mxCell id="p7-a1" value="Has an open&lt;br&gt;session?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325" y="306" width="190" height="96" as="geometry"/></mxCell><mxCell id="p7-a2" value="Open since a previous&lt;br&gt;day or for 14+ hours?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b58b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="671" y="304" width="200" height="100" as="geometry"/></mxCell><mxCell id="p7-a3" value='Auto-close the old&lt;br&gt;session: credit 8 hours,&lt;br&gt;flag "Needs Review"' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="671" y="478" width="200" height="76" as="geometry"/></mxCell><mxCell id="p7-a4" value='Show "You are&lt;br&gt;already clocked in"' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="938" y="486" width="160" height="60" as="geometry"/></mxCell><mxCell id="p7-a5" value="Create an attendance session&lt;br&gt;(time in, date, IP, device)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="305" y="640" width="230" height="64" as="geometry"/></mxCell><mxCell id="p7-a6" value="END&lt;br&gt;(Time In recorded)" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="782" width="180" height="56" as="geometry"/></mxCell><mxCell id="p7-a4e" value="END" style="shape=mxgraph.flowchart.terminator;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontStyle=1;fo